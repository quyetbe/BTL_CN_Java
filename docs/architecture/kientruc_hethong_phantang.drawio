        <!-- Khối chú thích chân trang -->
        <mxCell id="cell_footer" value="Ghi chú kiến trúc: 6 nhóm tác nhân người dùng tương tác thông qua Tầng Trình diễn (Java Swing Flat UI), mọi luồng dữ liệu đều được phân quyền RBAC chặt chẽ.&#xa;Các tầng nghiệp vụ và truy xuất dữ liệu độc lập, được bảo vệ và kiểm toán liên tục thông qua Trục An ninh &amp; Bổ trợ (Audit Log, SHA-256, PreparedStatement)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#333333;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1">
